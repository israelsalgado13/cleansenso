# ─────────────────────────────────────────────────────────────────────────────
# CleanSenso — Variables de entorno para ejecución LOCAL
# Copia este archivo como .env en la raíz del proyecto Next.js
# ─────────────────────────────────────────────────────────────────────────────

# URL del backend local (Node.js/Express)
NEXT_PUBLIC_API_URL=http://localhost:4000

# URL del sitio (para callbacks OAuth si se usa)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Supabase (dejar vacío si usas PostgreSQL local) ─────────────────────────
# Si quieres seguir usando Supabase cloud, pega tus claves aquí:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
