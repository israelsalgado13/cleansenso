# Copia como local-setup/.env (NO lo subas a Git). Lo lee docker-compose.yml.

# Usa una contraseña SIN caracteres especiales de URL (@ : / ? # %)
POSTGRES_PASSWORD=

# Genera uno con: openssl rand -hex 32   (mínimo 32 caracteres)
JWT_SECRET=

# Opcionales (valores por defecto entre paréntesis)
# POSTGRES_DB=cleansenso
# POSTGRES_USER=cleansenso_user
# FRONTEND_URL=http://localhost:3000
