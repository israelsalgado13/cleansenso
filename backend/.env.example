# Copia este archivo como backend/.env (NO lo subas a Git)

# Obligatorio. Genera uno con: openssl rand -hex 32   (mínimo 32 caracteres)
JWT_SECRET=

# Obligatorio. Ejemplo: postgresql://usuario:clave@localhost:5432/cleansenso
DATABASE_URL=

# Opcionales
PORT=4000
FRONTEND_URL=http://localhost:3000
# Si el backend está detrás de un proxy/balanceador (nginx, Render, etc.): número de proxies, ej. 1
# TRUST_PROXY=1
